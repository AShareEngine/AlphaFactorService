AB_FACTOR_HOST=127.0.0.1
AB_FACTOR_PORT=8100
AB_FACTOR_CORS_ORIGINS=*

# 默认复用 AlphaBlocksSyncData 的 runtime 配置。
# 也可以使用 SYNC_DATA_RUNTIME_CONFIG / ALPHABLOCKS_SYNC_DATA_RUNTIME_CONFIG /
# ALPHABLOCKS_RUNTIME_CONFIG / RUNTIME_CONFIG_PATH。
AB_FACTOR_RUNTIME_CONFIG=/Users/zhao/Desktop/git/AlphaBlocksSyncData/config/runtime.local.yaml

# 因子服务自己的 ClickHouse 库名。连接 host/port/user/password/secure 默认来自上面的 runtime。
AB_FACTOR_CLICKHOUSE_DATABASE=ab_factor
